+// PJRT-backed IFRT clients only compile HLO programs, so IFRT IR programs are
+// compiled with XLA's IFRT IR compiler, which compiles each atom program
+// through the client and runs the program with the IFRT IR interpreter. The
+// compiler must outlive in-flight compilations, so one is kept per client.
+xla::ifrt::Compiler* GetIfrtIrProgramCompiler(xla::ifrt::Client* client) {
+  if (client->runtime_type() != "pjrt_ifrt") {
+    return client->GetDefaultCompiler();
+  }
+  static absl::Mutex mu(absl::kConstInit);
+  static auto* compilers = new absl::flat_hash_map<
+      xla::ifrt::Client*, std::unique_ptr<xla::ifrt::IfrtIrProgramCompiler>>();
+  absl::MutexLock lock(mu);
+  std::unique_ptr<xla::ifrt::IfrtIrProgramCompiler>& compiler =
+      (*compilers)[client];
+  if (compiler == nullptr) {
+    compiler = std::make_unique<xla::ifrt::IfrtIrProgramCompiler>(
+        client,
+        [client](const xla::ifrt::IfrtIRCompileOptions& options)
+            -> absl::StatusOr<
+                std::unique_ptr<xla::ifrt::AtomProgramCompiler>> {
+          return xla::ifrt::BasicAtomProgramCompiler::Create(
+              client, options.device_assignments,
+              options.strict_memory_reservation);
+        });
+  }
+  return compiler.get();
+}
